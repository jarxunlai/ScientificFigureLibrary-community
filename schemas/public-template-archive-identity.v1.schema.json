{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jarxunlai/ScientificFigureLibrary-community/blob/main/schemas/public-template-archive-identity.v1.schema.json",
  "title": "Public template archive identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "commit", "path", "bytes", "sha256"],
  "properties": {
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "path": { "type": "string", "pattern": "^archives/[a-z0-9._-]+/[0-9A-Za-z.-]+/[a-z0-9._-]+-[0-9A-Za-z.-]+\\.zip$" },
    "bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
