{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jarxunlai/ScientificFigureLibrary-community/blob/main/schemas/public-provider-catalog.v1.schema.json",
  "title": "Scientific Figure Library public Provider Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "generatedAt", "entries"],
  "properties": {
    "schema": { "const": "figure-library.public-provider-catalog.v1" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "displayName", "catalogRepository", "archiveRepository"],
      "properties": {
        "providerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,126}[a-z0-9]$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "catalogRepository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "archiveRepository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": { "$ref": "public-template-entry.v1.schema.json" }
    }
  }
}
